#include <winres.h>

// ISOLATIONAWARE_MANIFEST_RESOURCE_ID, picked up by ISOLATION_AWARE_ENABLED code in Editor.cpp.
2 RT_MANIFEST "dpdfnet.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "DPDFNet noise suppression (VST2)"
			VALUE "FileVersion", "1.0.0"
			VALUE "ProductName", "DPDFNet"
			VALUE "ProductVersion", "1.0.0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
